# 61API 私有化部署环境变量
# 复制为 deploy/61api.env 并替换所有占位值;该文件权限必须是 600,且不得进入 Git。

APP_ENV=production
DEPLOYMENT_MODE=private
SITE_NAME=61API 企业网关
SITE_URL=http://127.0.0.1:8300
CORS_ORIGINS=http://127.0.0.1:8300
# 反向代理在本机时:127.0.0.1 是直连;Docker 容器看到的代理地址通常是 172.16.0.0/12 网段。
# 如代理在另一台机器,改成代理的真实出口 IP/CIDR。
TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12

# 两个都必须用 `openssl rand -hex 32` 生成,且互相不同
SECRET_KEY_61API=REPLACE_WITH_OPENSSL_RAND_HEX_32
API_KEY_PEPPER=REPLACE_WITH_ANOTHER_OPENSSL_RAND_HEX_32

# 首次启动创建的管理员;登录后请立即修改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# 默认组织名(首次建库时创建;已存在则不覆盖)
PRIVATE_TENANT_NAME=默认组织
# 默认组织初始额度(元);-1 表示不限
DEFAULT_TENANT_QUOTA_YUAN=-1

# 私有化模式默认全部关闭;如确需开启,显式设为 true 并自行完成合规评估
FEATURE_PUBLIC_SIGNUP=false
FEATURE_SMS=false
FEATURE_PAYMENTS=false
FEATURE_INVITE=false
FEATURE_REDEEM=false
FEATURE_INVOICE=false

# 私有化模式不需要短信与支付凭据
SMS_MODE=off
PAYKIT_MODE=off

# 会话 Cookie 是否只走 HTTPS。
# 首次用 http://127.0.0.1:8300 验收时保持 false;接入 TLS 反向代理后改为 true。
SESSION_COOKIE_SECURE=false

# 并发与限流(可按机器规格调整)
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_MAX_CONCURRENT_PER_USER=4
JWT_TTL_SECONDS=28800

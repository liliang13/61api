APP_ENV=production
SECRET_KEY_61API=REPLACE_WITH_OPENSSL_RAND_HEX_32_OUTPUT
API_KEY_PEPPER=REPLACE_WITH_ANOTHER_OPENSSL_RAND_HEX_32_OUTPUT
SITE_NAME=61API
SITE_URL=https://61api.cn
CORS_ORIGINS=https://61api.cn
TRUSTED_PROXY_IPS=127.0.0.1
ALIYUN_CAPTCHA_ACCESS_KEY_ID=REPLACE_WITH_ALIYUN_ACCESS_KEY_ID
ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=REPLACE_WITH_ALIYUN_ACCESS_KEY_SECRET
ALIYUN_CAPTCHA_SCENE_ID=REPLACE_WITH_ALIYUN_CAPTCHA_SCENE_ID
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_ADMIN_PASSWORD
SMS_MODE=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=REPLACE_WITH_ALIYUN_SMS_ACCESS_KEY_ID
ALIYUN_SMS_ACCESS_KEY_SECRET=REPLACE_WITH_ALIYUN_SMS_ACCESS_KEY_SECRET
ALIYUN_SMS_SIGN_NAME=REPLACE_WITH_SMS_SIGN_NAME
ALIYUN_SMS_TEMPLATE_CODE=REPLACE_WITH_SMS_TEMPLATE_CODE
PAYKIT_PATH=/opt/paykit
PAYKIT_MODE=alipay
# Append the Alipay variables required by the installed paykit version here.
# 站长 Bark 推送(注册/支付提醒);两项都填才启用,留空停用。
BARK_SERVER_URL=
BARK_DEVICE_KEY=
# Use placeholders only in this example; keep real keys and certificates out of Git.
